# =====================================================================
# Sekrety i dane lokalne - skopiuj ten plik jako .env i uzupelnij wartosci.
# Spring wczytuje ten plik przez spring.config.import,
# a docker compose czyta go automatycznie.
# =====================================================================

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/pgDB
DB_USERNAME=
DB_PASSWORD=
POSTGRES_DB=pgDB
POSTGRES_USER=
POSTGRES_PASSWORD=

# JWT
JWT_SECRET=

# SMTP (np. Gmail + haslo aplikacji)
MAIL_USERNAME=
MAIL_PASSWORD=

# Konto administratora tworzone przy starcie
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
